    {
      "key": "tay-roots",
      "route": "/community/tay-roots",
      "frameId": "25:39",
      "title": {
        "path": "community/type/tay-roots-title.svg",
        "text": "THE TAY ROOTS",
        "width": 496,
        "height": 58,
        "offsetX": 1.1040000915527344,
        "offsetY": 11.39999771118164,
        "artWidth": 492.0,
        "artHeight": 34.0
      },
      "titleX": 213,
      "titleY": 132,
      "body": "I believe education becomes more meaningful when it grows from the community itself. Through The Tay Roots Project, I teach English to nearly 40 students from primary to high school through both online classes and regular trips to Tuyên Quang, where we meet in person every two months. I help develop lessons from foundational to more advanced English, connecting what we teach with local life, Tày culture, and the landscapes around them.\nOur visits go beyond the classroom. We create opportunities for the students to experience and share their own culture, while bringing small gifts and activities that make each visit something they can look forward to. The project was later featured by Tuyên Quang Newspaper for its work connecting English education with Tày cultural heritage and local communities.",
      "bodyX": 97,
      "bodyY": 224,
      "bodyWidth": 496,
      "background": "inquiry/project-background@2x.png",
